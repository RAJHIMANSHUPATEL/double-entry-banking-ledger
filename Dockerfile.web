FROM node:22-alpine AS build

WORKDIR /srv

COPY web/package.json web/package-lock.json ./web/
COPY src/domain/money.js ./src/domain/money.js

WORKDIR /srv/web
RUN npm ci

COPY web/ ./
RUN npm run build

FROM node:22-alpine

WORKDIR /srv

COPY --from=build /srv/web/package.json /srv/web/package-lock.json ./web/
COPY --from=build /srv/web/node_modules ./web/node_modules
COPY --from=build /srv/web/dist ./web/dist
COPY --from=build /srv/web/vite.config.js ./web/vite.config.js
COPY --from=build /srv/web/index.html ./web/index.html
COPY src/domain/money.js ./src/domain/money.js

WORKDIR /srv/web

ENV API_PROXY_TARGET=http://api:3000

EXPOSE 8080

CMD ["npm", "run", "preview"]
